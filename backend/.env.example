# Copy to .env and fill in. Never commit .env.
# From https://developers.kite.trade -> My apps -> your app
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret

# true  = PAPER mode: orders are simulated in algo.db, nothing is sent to Zerodha
# false = LIVE mode: real LIMIT orders on your Zerodha account
DRY_RUN=true

# Paper mode only: allow simulated fills outside 09:15-15:30 IST (handy for weekend testing)
PAPER_IGNORE_MARKET_HOURS=false

FRONTEND_URL=http://localhost:4200
# How often the public IP is re-checked (seconds). It is also re-checked right before every order.
IP_CHECK_INTERVAL_SECONDS=15
STRATEGY_INTERVAL_SECONDS=300

# Public IP lookup. api64 is dual-stack, so it reports the IP (IPv4 or IPv6) your PC really uses
# to reach the internet - the same one Zerodha sees. Use https://api.ipify.org?format=json to force IPv4.
IP_LOOKUP_URL=https://api64.ipify.org?format=json
# Independent second lookup to detect a shared (CGNAT) IP that changes per connection. Leave empty to disable.
IP_SECONDARY_LOOKUP_URL=https://icanhazip.com
